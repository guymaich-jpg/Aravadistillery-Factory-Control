{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command","command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"}]}]
  },
  "permissions": {
    "allow": [
      "Bash(git add*)", "Bash(git commit*)", "Bash(git checkout*)",
      "Bash(git fetch*)", "Bash(git pull*)", "Bash(git push origin fix/*)",
      "Bash(git push origin feat/*)", "Bash(git push origin improve/*)",
      "Bash(git push origin chore/*)", "Bash(gh pr create*)",
      "Bash(gh pr merge*)", "Bash(gh release create*)",
      "Bash(curl -s https://api.vercel.com/*)",
      "Bash(curl -s -X POST https://api.vercel.com/*)",
      "Bash(curl -s -X PATCH https://api.vercel.com/*)"
    ]
  }
}
